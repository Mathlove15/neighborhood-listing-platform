{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/property.schema.json",
  "title": "Property",
  "description": "A validated fictional property listing for the neighborhood listing platform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "address",
    "zip_code",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "description",
    "property_type",
    "listing_status",
    "image_url",
    "amenities",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "pattern": "^PROP-[0-9]{3}$",
      "description": "A unique property identifier such as PROP-001."
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "street",
        "city",
        "state"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 5
        },
        "city": {
          "type": "string",
          "minLength": 2
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "zip_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "square_feet": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "property_type": {
      "type": "string",
      "enum": [
        "house",
        "condominium",
        "townhouse",
        "apartment"
      ]
    },
    "listing_status": {
      "type": "string",
      "enum": [
        "available",
        "pending",
        "sold"
      ]
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "amenities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "local_sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sponsor_id",
          "placement",
          "is_featured"
        ],
        "properties": {
          "sponsor_id": {
            "type": "string",
            "pattern": "^SPON-[0-9]{3}$"
          },
          "placement": {
            "type": "string",
            "enum": [
              "property_card",
              "detail_page",
              "voice_response"
            ]
          },
          "is_featured": {
            "type": "boolean"
          }
        }
      }
    }
  }
}